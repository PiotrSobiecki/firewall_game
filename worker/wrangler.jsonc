{
  // Cloudflare Worker: API rankingu dla gry Firewall (Hono + Neon).
  // DATABASE_URL ustaw jako sekret: `wrangler secret put DATABASE_URL`
  "name": "firewall-scores",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "observability": { "enabled": true },
  // Limit zapisów wyniku: 10 na minutę z jednego IP (kod w src/index.ts przepuszcza, gdy bindingu brak).
  "ratelimits": [{ "name": "SCORE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
